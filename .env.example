# EchoMind 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# ── 应用 ──────────────────────────────────────────────────────────────────────
APP_NAME=EchoMind
APP_ENV=production
LOG_LEVEL=INFO

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Anthropic Claude ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 可选：覆盖为兼容 Anthropic 协议的第三方 API（如 DeepSeek）
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# Intent fusion. Replace these values with the selected validation result.
INTENT_EMBEDDING_ENABLED=false
INTENT_LLM_WEIGHT=0.85
INTENT_EMBEDDING_WEIGHT=0.0
INTENT_PATTERN_WEIGHT=0.15
INTENT_CONFIDENCE_THRESHOLD=0.5
INTENT_MULTI_LABEL_THRESHOLD=0.6

# 可选：覆盖模型名称（默认 claude-3-5-sonnet-20241022）
# 使用 DeepSeek V4 时设为 deepseek-v4-pro；低成本/高并发场景可用 deepseek-v4-flash
# ANTHROPIC_MODEL=deepseek-v4-pro

# ── 专用 Reranker ────────────────────────────────────────────────────────────
# 默认使用本地 ONNX Cross-Encoder；首次检索重排时下载约 1GB 模型并缓存。
RERANK_PROVIDER=fastembed
RERANK_MODEL=jinaai/jina-reranker-v2-base-multilingual

# 中文知识库与情景记忆共用的本地 Embedding 模型
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_CACHE_DIR=/app/data/fastembed-cache
RERANK_CACHE_DIR=./data/reranker-cache
# 资源受限或离线且尚未缓存模型时，可临时设置为 disabled，退回向量召回顺序。
# RERANK_PROVIDER=disabled

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=echomind123

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIRECTORY=./data/chroma

# ── 监控 ──────────────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9091
ANOMALY_DETECTION_THRESHOLD=2.0

# ── 评测 ──────────────────────────────────────────────────────────────────────
EVAL_BASELINE_PATH=./data/eval/baseline.json
EVIDENCE_MAX_REFLECTIONS=1
# RAGAS Answer Relevancy 使用的本地中文 ONNX Embedding；首次评测时下载并缓存
RAGAS_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ── Skills ───────────────────────────────────────────────────────────────────
# 默认读取项目内 ./skills，支持运行时通过 POST /skills/reload 热加载
ECHOMIND_SKILLS_DIR=./skills
ECHOMIND_SKILLS_MAX_PROMPT_CHARS=5000

# ── 安全 ──────────────────────────────────────────────────────────────────────
SECRET_KEY=change_this_in_production
# disabled 保持匿名开发模式；jwt 会要求非公开接口携带 Bearer Token
AUTH_MODE=disabled
# HS256 本地演示密钥至少 32 字节；生产环境请使用密钥管理系统随机生成
JWT_SECRET_KEY=replace_with_at_least_32_random_bytes
JWT_ISSUER=echomind-demo
JWT_AUDIENCE=echomind-api

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ── 功能开关 ──────────────────────────────────────────────────────────────────
ENABLE_SWAGGER_UI=true
ENABLE_MONITORING=true
ENABLE_EVALUATION=true
